---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 md:px-8">
    <a href="/" class="font-display text-lg font-bold tracking-tight cursor-pointer">
      Zaki<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navigasi utama">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink-muted transition-colors duration-200 hover:text-ink cursor-pointer"
        >
          {link.label}
        </a>
      ))}

      <button
        type="button"
        id="lang-toggle"
        class="flex h-11 cursor-pointer items-center gap-1 rounded-full border border-line bg-surface px-3 text-xs font-medium"
        aria-label="Ganti bahasa ke English"
      >
        <span class="text-ink">ID</span>
        <span class="text-ink-muted">/ EN</span>
      </button>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-line bg-surface md:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-line bg-surface px-5 py-4 md:hidden"
    aria-label="Navigasi mobile"
  >
    <ul class="flex flex-col gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg px-3 py-3 text-sm font-medium text-ink-muted transition-colors duration-200 hover:bg-accent-soft hover:text-ink cursor-pointer"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 px-3">
        <button
          type="button"
          class="mobile-lang-toggle flex h-11 cursor-pointer items-center gap-1 rounded-full border border-line px-4 text-xs font-medium"
          aria-label="Ganti bahasa ke English"
        >
          <span class="text-ink">ID</span>
          <span class="text-ink-muted">/ EN</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi');
  });

  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      mobileMenu.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
      menuToggle?.focus();
    }
  });
</script>
