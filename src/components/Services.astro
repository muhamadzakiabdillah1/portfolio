---
import SectionMotif from './SectionMotif.astro';

const services = [
  {
    title: 'UI/UX Design',
    description:
      'Merancang antarmuka aplikasi & website yang intuitif, dari riset hingga prototyping.',
    icon: 'M4 5h16v12H4z M4 9h16 M9 21h6 M12 17v4',
  },
  {
    title: 'Poster & Graphic Design',
    description: 'Poster promosi dan materi visual yang mencuri perhatian.',
    icon: 'M4 4h16v16H4z M4 15l4-4 4 4 5-5 3 3 M9 8.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z',
  },
  {
    title: 'Social Media Design',
    description: 'Konten sosmed yang konsisten dan on-brand, dari feed hingga story.',
    icon: 'M9 3h6v6H9z M3 15h6v6H3z M15 15h6v6h-6z M12 9v3 M6 15v-3h12v3',
  },
];
---

<section id="services" class="relative mx-auto max-w-6xl scroll-mt-20 overflow-hidden px-5 py-24 md:px-8">
  <!-- Motif section: plus (identitas Services) -->
  <SectionMotif type="plus" class="-bottom-16 -left-16 h-56 w-56 lg:h-72 lg:w-72" />

  <p class="reveal mb-12 flex items-center gap-3 text-xs font-medium tracking-[0.25em] text-ink-muted uppercase">
    <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <path d="M50 4v92M4 50h92M17 17l66 66M83 17l-66 66" stroke="currentColor" stroke-width="10" stroke-linecap="round"></path>
    </svg>
    <span data-i18n="services.kicker">02 — Layanan</span>
  </p>

  <h2 class="reveal max-w-xl font-display text-3xl font-bold tracking-tight sm:text-4xl" data-i18n="services.h2">
    Apa yang bisa saya bantu?
  </h2>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {services.map((service, i) => (
      <article
        class="reveal group rounded-2xl border border-line bg-surface p-8 transition-shadow duration-200 hover:shadow-[0_16px_40px_-16px] hover:shadow-accent/15"
        style={`animation-delay: ${i * 100}ms`}
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent-soft text-accent transition-colors duration-200 group-hover:bg-accent group-hover:text-white dark:group-hover:text-bg"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={service.icon}></path>
          </svg>
        </div>

        <h3 class="mt-6 font-display text-lg font-semibold tracking-tight">
          <span class="mr-2 font-body text-xs font-medium text-ink-muted" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {service.title}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted" data-i18n={`services.${i + 1}d`}>{service.description}</p>
      </article>
    ))}
  </div>

  <p class="reveal mt-10 max-w-xl text-sm leading-relaxed text-ink-muted" data-i18n="services.note">
    Saya masih belajar, jadi terbuka untuk proyek kecil.
  </p>
</section>
