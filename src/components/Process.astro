---
import SectionMotif from './SectionMotif.astro';

const steps = [
  {
    num: '01',
    title: 'Discover',
    description: 'Ngobrol santai untuk paham kebutuhan, target audiens, dan gaya yang kamu mau.',
  },
  {
    num: '02',
    title: 'Design',
    description: 'Menyusun konsep dan desain awal, dikirim tepat waktu untuk kamu review.',
  },
  {
    num: '03',
    title: 'Revise',
    description: 'Bebas beri masukan — kita poles bersama sampai hasilnya terasa pas.',
  },
  {
    num: '04',
    title: 'Deliver',
    description: 'File final rapi dan siap pakai, lengkap dengan panduan singkat.',
  },
];
---

<section id="process" class="relative mx-auto max-w-6xl scroll-mt-20 overflow-hidden px-5 py-24 md:px-8">
  <!-- Motif section: asterisk besar, menggemakan Hero -->
  <SectionMotif type="asterisk" class="-bottom-24 -right-24 h-80 w-80 rotate-12 lg:h-[28rem] lg:w-[28rem]" />

  <p class="reveal mb-12 flex items-center gap-3 text-xs font-medium tracking-[0.25em] text-ink-muted uppercase">
    <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <path d="M50 4v92M4 50h92M17 17l66 66M83 17l-66 66" stroke="currentColor" stroke-width="10" stroke-linecap="round"></path>
    </svg>
    <span data-i18n="process.kicker">04 — Process</span>
  </p>

  <h2 class="reveal max-w-xl font-display text-3xl font-bold tracking-tight sm:text-4xl" data-i18n="process.h2">
    Dari ide jadi karya, dalam 4 langkah.
  </h2>

  <ol class="mt-14 grid gap-10 md:grid-cols-4 md:gap-6" role="list">
    {steps.map((step, i) => (
      <li
        class:list={[
          'reveal relative border-l-2 border-line pl-6 md:border-l-0 md:border-t-2 md:pl-0 md:pt-8',
          i === 1 && 'reveal-delay-1',
          i === 2 && 'reveal-delay-2',
          i === 3 && 'reveal-delay-3',
        ]}
      >
        <!-- Titik di garis timeline -->
        <span
          class="absolute -left-[7px] top-0 h-3 w-3 rounded-full border-2 border-accent bg-bg md:-top-[7px] md:left-1/2 md:-translate-x-1/2"
          aria-hidden="true"
        >
        </span>

        <span
          class="font-display text-5xl font-bold text-accent/20 transition-colors duration-200 md:text-6xl"
          aria-hidden="true"
        >
          {step.num}
        </span>
        <h3 class="mt-3 font-display text-lg font-semibold tracking-tight">{step.title}</h3>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-muted" data-i18n={`process.${i + 1}d`}>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
