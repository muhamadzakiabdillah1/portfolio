---
import SectionMotif from './SectionMotif.astro';

const email = 'muhamadzakiabdillah1@gmail.com';
const instagram = 'muhamadzaakkii';
---

<section id="contact" class="relative mx-auto max-w-6xl scroll-mt-20 overflow-hidden px-5 py-24 md:px-8">
  <!-- Motif section: ring, menggemakan About -->
  <SectionMotif type="ring" class="-bottom-28 -left-28 h-72 w-72 lg:h-96 lg:w-96" />

  <p class="reveal mb-12 flex items-center gap-3 text-xs font-medium tracking-[0.25em] text-ink-muted uppercase">
    <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 100 100" fill="none" aria-hidden="true">
      <path d="M50 4v92M4 50h92M17 17l66 66M83 17l-66 66" stroke="currentColor" stroke-width="10" stroke-linecap="round"></path>
    </svg>
    <span data-i18n="contact.kicker">05 — Contact</span>
  </p>

  <h2 class="reveal max-w-xl font-display text-3xl font-bold tracking-tight sm:text-4xl">
    <span data-i18n="contact.h2a">Punya project atau posisi yang cocok?</span>
    <span class="text-accent" data-i18n="contact.h2b">Mari ngobrol.</span>
  </h2>

  <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-16">
    <!-- Form: kirim via email client (mailto) — upgrade ke form service saat hosting -->
    <form id="contact-form" novalidate class="reveal flex flex-col gap-6">
      <div>
        <label for="nama" class="mb-2 block text-sm font-medium" data-i18n="contact.label.nama">Nama</label>
        <input
          type="text"
          id="nama"
          name="nama"
          required
          autocomplete="name"
          placeholder="Nama kamu"
          data-i18n-placeholder="contact.ph.nama"
          class="h-12 w-full rounded-xl border border-line bg-surface px-4 text-sm transition-colors duration-200 placeholder:text-ink-muted/60 focus:border-accent"
        />
      </div>

      <div>
        <label for="email" class="mb-2 block text-sm font-medium" data-i18n="contact.label.email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="email@kamu.com"
          data-i18n-placeholder="contact.ph.email"
          class="h-12 w-full rounded-xl border border-line bg-surface px-4 text-sm transition-colors duration-200 placeholder:text-ink-muted/60 focus:border-accent"
        />
      </div>

      <div>
        <label for="pesan" class="mb-2 block text-sm font-medium" data-i18n="contact.label.pesan">Pesan</label>
        <textarea
          id="pesan"
          name="pesan"
          required
          rows="5"
          placeholder="Ceritakan project atau kebutuhanmu..."
          data-i18n-placeholder="contact.ph.pesan"
          class="w-full rounded-xl border border-line bg-surface px-4 py-3 text-sm transition-colors duration-200 placeholder:text-ink-muted/60 focus:border-accent"></textarea>
      </div>

<button
        type="submit"
        class="group inline-flex h-12 cursor-pointer items-center gap-2 rounded-full bg-accent px-7 text-sm font-medium text-white transition-colors duration-200 hover:bg-ink dark:text-bg"
      >
        <span data-i18n="contact.submit">Kirim Pesan</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"></path>
        </svg>
      </button>
      <p class="text-xs text-ink-muted" data-i18n="contact.mailtoNote">
        Tombol ini akan membuka aplikasi email kamu dengan pesan yang sudah terisi otomatis.
      </p>
    </form>

    <!-- Kontak langsung -->
    <div class="reveal reveal-delay-1 flex flex-col gap-4">
      <p class="text-sm leading-relaxed text-ink-muted" data-i18n="contact.side">
        Lebih suka kontak langsung? Reach me here:
      </p>

      <a
        href={`mailto:${email}`}
        class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-line bg-surface p-5 transition-colors duration-200 hover:border-accent/30"
      >
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block text-xs font-medium tracking-wide text-ink-muted uppercase">Email</span>
          <span class="block truncate text-sm font-medium group-hover:text-accent">{email}</span>
        </span>
      </a>

      <a
        href={`https://instagram.com/${instagram}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-line bg-surface p-5 transition-colors duration-200 hover:border-accent/30"
      >
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="0.5" fill="currentColor"></circle>
          </svg>
        </span>
        <span>
          <span class="block text-xs font-medium tracking-wide text-ink-muted uppercase">Instagram</span>
          <span class="block text-sm font-medium group-hover:text-accent">@{instagram}</span>
        </span>
      </a>

      <p class="mt-2 text-xs leading-relaxed text-ink-muted" data-i18n="contact.waNote">
        WhatsApp, Behance, dan LinkedIn menyusul — akunnya sedang disiapkan.
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Validasi custom sebelum submit
    const nama = (form.querySelector('#nama') as HTMLInputElement).value.trim();
    const emailPengirim = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const pesan = (form.querySelector('#pesan') as HTMLTextAreaElement).value.trim();

    if (!nama) {
      alert('Nama wajib diisi');
      return;
    }
    if (!emailPengirim || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailPengirim)) {
      alert('Format email tidak valid');
      return;
    }
    if (!pesan) {
      alert('Pesan wajib diisi');
      return;
    }

    const subject = encodeURIComponent(`Halo Zaki, saya ${nama}`);
    const body = encodeURIComponent(`${pesan}\n\n— ${nama} (${emailPengirim})`);

    window.location.href = `mailto:muhamadzakiabdillah1@gmail.com?subject=${subject}&body=${body}`;
  });
</script>
