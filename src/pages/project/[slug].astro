---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SectionMotif from '../../components/SectionMotif.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      project: entry,
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, next } = Astro.props;
---

<Layout title={`${project.data.title} — Muhamad Zaki Abdillah`}>
  <Header />
  <main class="relative mx-auto max-w-6xl overflow-hidden px-5 py-16 md:px-8">
    <!-- Motif asterisk besar menyesuaikan ruang — mirip halaman Process -->
    <SectionMotif type="asterisk" class="-top-16 -right-16 h-80 w-80 rotate-12 lg:h-[32rem] lg:w-[32rem]" />

    <a
      href="/#projects"
      class="reveal inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-ink-muted transition-colors duration-200 hover:text-ink"
      data-i18n="cs.back"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12l7.5-7.5M3 12h18"></path>
      </svg>
      Semua project
    </a>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
        {project.data.categoryLabel}
      </span>
      <span class="text-xs font-medium text-ink-muted">{project.data.year}</span>
      <span class="text-xs font-medium text-ink-muted">· {project.data.tools.join(', ')}</span>
    </div>

    <h1
      class="reveal mt-4 max-w-2xl font-display text-3xl font-bold tracking-tight sm:text-5xl"
      data-text-id={project.data.title}
      data-text-en={project.data.titleEn}
    >
      {project.data.title}
    </h1>
    <p
      class="reveal reveal-delay-1 mt-4 max-w-prose leading-relaxed text-ink-muted"
      data-text-id={project.data.summary}
      data-text-en={project.data.summaryEn}
    >
      {project.data.summary}
    </p>

    <div class="reveal reveal-delay-2 mt-10 overflow-hidden rounded-2xl border border-line bg-surface p-4 sm:p-8">
      <Image
        src={project.data.thumbnail}
        alt={`Karya utama: ${project.data.title}`}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 1104px, 100vw"
        format="webp"
        loading="eager"
        class="h-auto w-full rounded-xl object-cover"
      />
    </div>

    <div class="mt-16 grid gap-12 md:grid-cols-[auto_1fr] md:gap-16">
      <div class="flex flex-row gap-10 md:flex-col">
        <div>
          <h2 class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase" data-i18n="cs.challenge">Tantangan</h2>
          <p
            class="mt-4 max-w-prose leading-relaxed text-ink-muted"
            data-text-id={project.data.problem}
            data-text-en={project.data.problemEn}
          >
            {project.data.problem}
          </p>
        </div>
        <div>
          <h2 class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase" data-i18n="cs.solution">Solusi &amp; Hasil</h2>
          <p
            class="mt-4 max-w-prose leading-relaxed text-ink-muted"
            data-text-id={project.data.solution}
            data-text-en={project.data.solutionEn}
          >
            {project.data.solution}
          </p>
        </div>
      </div>
      <div class="max-w-prose border-t border-line pt-8 md:border-l md:border-t-0 md:pl-16 md:pt-0">
        <h2 class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase" data-i18n="cs.notes">Catatan Desainer</h2>
        <p
          class="mt-4 leading-relaxed text-ink"
          data-text-id={project.data.note}
          data-text-en={project.data.noteEn}
        >
          {project.data.note}
        </p>
      </div>
    </div>

    {
      project.data.processImages && project.data.processImages.length > 0 && (
        <div class="mt-16">
          <h2 class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase" data-i18n="cs.process">Proses</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {project.data.processImages.map((img, i) => (
              <div class="overflow-hidden rounded-2xl border border-line bg-surface p-4 sm:p-6">
                <Image
                  src={img}
                  alt={`Proses desain ${project.data.title} — bagian ${i + 1}`}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  format="webp"
                  loading="lazy"
                  class="h-auto w-full rounded-lg"
                />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <a
      href={`/project/${next.id}/`}
      class="group mt-20 flex cursor-pointer items-center justify-between gap-6 rounded-2xl border border-line bg-surface p-8 transition-colors duration-200 hover:border-accent/30"
    >
      <div>
        <p class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase" data-i18n="cs.next">Project berikutnya</p>
        <p class="mt-2 font-display text-2xl font-bold tracking-tight transition-colors duration-200 group-hover:text-accent sm:text-3xl">
          {next.data.title}
        </p>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-8 w-8 shrink-0 text-accent transition-transform duration-200 group-hover:translate-x-2"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </main>
</Layout>
