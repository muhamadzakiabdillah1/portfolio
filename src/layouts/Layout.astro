---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Muhamad Zaki Abdillah — UI/UX & Graphic Designer',
  description =
    'Portofolio Muhamad Zaki Abdillah. Desain yang punya tujuan, ide yang diwujudkan. Terbuka untuk proyek freelance.',
} = Astro.props;

// Sticky CTA mobile hanya di beranda (halaman case study tidak punya #contact)
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://muhamadzaki-portfolio.vercel.app/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Muhamad Zaki Abdillah — UI/UX & Graphic Designer"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@700,600,500&f[]=general-sans@400,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Anti-flash: pasang .dark sebelum paint (localStorage > preferensi OS)
      (function () {
        try {
          var t = localStorage.getItem('portfolio-theme');
          var dark =
            t === 'dark'
              ? true
              : t === 'light'
                ? false
                : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg font-body text-ink antialiased">
    <slot />

    {isHome && (
      <a
        href="#contact"
        class="fixed inset-x-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded-full bg-accent text-sm font-medium text-white shadow-[0_8px_24px_-8px] shadow-accent/25 transition-colors duration-200 hover:bg-ink md:hidden dark:text-bg"
      >
        <span data-i18n="hero.cta2">Hubungi Saya</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    )}

    <script>
      import { translations, type Lang } from '../i18n/dictionary';

      const STORAGE_KEY = 'portfolio-lang';
      let lang: Lang = localStorage.getItem(STORAGE_KEY) === 'en' ? 'en' : 'id';

      function updateToggleButtons() {
        document.querySelectorAll<HTMLButtonElement>('#lang-toggle, .mobile-lang-toggle').forEach((btn) => {
          btn.innerHTML = `<span class="${lang === 'id' ? 'text-ink' : 'text-ink-muted'}">ID</span><span class="text-ink-muted"> / </span><span class="${lang === 'en' ? 'text-ink' : 'text-ink-muted'}">EN</span>`;
          btn.setAttribute(
            'aria-label',
            lang === 'id' ? 'Ganti bahasa ke English' : 'Ganti bahasa ke Indonesia',
          );
        });
      }

      function apply(l: Lang) {
        lang = l;
        localStorage.setItem(STORAGE_KEY, l);
        document.documentElement.lang = l;

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const entry = translations[el.dataset.i18n!];
          if (entry) el.textContent = entry[l];
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
          const entry = translations[el.dataset.i18nPlaceholder!];
          if (entry) el.setAttribute('placeholder', entry[l]);
        });

        // Konten dinamis: kartu project
        document.querySelectorAll<HTMLElement>('[data-title-id]').forEach((el) => {
          el.textContent = l === 'en' ? el.dataset.titleEn! : el.dataset.titleId!;
        });
        document.querySelectorAll<HTMLElement>('[data-desc-id]').forEach((el) => {
          el.textContent = l === 'en' ? el.dataset.descEn! : el.dataset.descId!;
        });

        // Konten dinamis: case study (title, summary, problem, solution, note)
        document.querySelectorAll<HTMLElement>('[data-text-id]').forEach((el) => {
          const en = el.dataset.textEn;
          el.textContent = l === 'en' && en ? en : el.dataset.textId!;
        });

        updateToggleButtons();
      }

      document.querySelectorAll<HTMLButtonElement>('#lang-toggle, .mobile-lang-toggle').forEach((btn) => {
        btn.addEventListener('click', () => apply(lang === 'id' ? 'en' : 'id'));
      });

      apply(lang);

      // ---- Theme toggle (dark mode class-based) ----
      const THEME_KEY = 'portfolio-theme';

      function paintTheme(dark: boolean) {
        document
          .querySelectorAll<HTMLButtonElement>('#theme-toggle, .mobile-theme-toggle')
          .forEach((btn) => {
            btn.querySelector('[data-icon="moon"]')?.classList.toggle('hidden', dark);
            btn.querySelector('[data-icon="sun"]')?.classList.toggle('hidden', !dark);
            btn.setAttribute('aria-pressed', String(dark));
            btn.setAttribute('aria-label', dark ? 'Ganti ke mode terang' : 'Ganti ke mode gelap');
          });
      }

      function setTheme(dark: boolean, persist = true) {
        document.documentElement.classList.toggle('dark', dark);
        if (persist) {
          try {
            localStorage.setItem(THEME_KEY, dark ? 'dark' : 'light');
          } catch {
            /* abaikan: mode privat */
          }
        }
        paintTheme(dark);
      }

      document
        .querySelectorAll<HTMLButtonElement>('#theme-toggle, .mobile-theme-toggle')
        .forEach((btn) => {
          btn.addEventListener('click', () =>
            setTheme(!document.documentElement.classList.contains('dark')),
          );
        });

      // Sinkron dengan hasil anti-flash script (tanpa tulis ulang storage)
      setTheme(document.documentElement.classList.contains('dark'), false);
    </script>
  </body>
</html>
