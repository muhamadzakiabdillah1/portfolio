---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Muhamad Zaki Abdillah — UI/UX & Graphic Designer',
  description =
    'Portofolio Muhamad Zaki Abdillah. UI yang enak dipakai, desain yang enak dilihat. Terbuka untuk proyek freelance.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@700,600,500&f[]=general-sans@400,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-bg font-body text-ink antialiased">
    <slot />

    <script>
      import { translations, type Lang } from '../i18n/dictionary';

      const STORAGE_KEY = 'portfolio-lang';
      let lang: Lang = localStorage.getItem(STORAGE_KEY) === 'en' ? 'en' : 'id';

      function updateToggleButtons() {
        document.querySelectorAll<HTMLButtonElement>('#lang-toggle, .mobile-lang-toggle').forEach((btn) => {
          btn.innerHTML = `<span class="${lang === 'id' ? 'text-ink' : 'text-ink-muted'}">ID</span><span class="text-ink-muted"> / </span><span class="${lang === 'en' ? 'text-ink' : 'text-ink-muted'}">EN</span>`;
          btn.setAttribute(
            'aria-label',
            lang === 'id' ? 'Ganti bahasa ke English' : 'Ganti bahasa ke Indonesia',
          );
        });
      }

      function apply(l: Lang) {
        lang = l;
        localStorage.setItem(STORAGE_KEY, l);
        document.documentElement.lang = l;

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const entry = translations[el.dataset.i18n!];
          if (entry) el.textContent = entry[l];
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
          const entry = translations[el.dataset.i18nPlaceholder!];
          if (entry) el.setAttribute('placeholder', entry[l]);
        });

        // Konten dinamis: kartu project
        document.querySelectorAll<HTMLElement>('[data-title-id]').forEach((el) => {
          el.textContent = l === 'en' ? el.dataset.titleEn! : el.dataset.titleId!;
        });
        document.querySelectorAll<HTMLElement>('[data-desc-id]').forEach((el) => {
          el.textContent = l === 'en' ? el.dataset.descEn! : el.dataset.descId!;
        });

        // Konten dinamis: case study (title, summary, problem, solution, note)
        document.querySelectorAll<HTMLElement>('[data-text-id]').forEach((el) => {
          const en = el.dataset.textEn;
          el.textContent = l === 'en' && en ? en : el.dataset.textId!;
        });

        updateToggleButtons();
      }

      document.querySelectorAll<HTMLButtonElement>('#lang-toggle, .mobile-lang-toggle').forEach((btn) => {
        btn.addEventListener('click', () => apply(lang === 'id' ? 'en' : 'id'));
      });

      apply(lang);
    </script>
  </body>
</html>
